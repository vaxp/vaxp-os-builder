{
  "_comment": "NyroShell — auto-generated default layout.",
  "panel": {
    "height"  : 36,
    "position": "top",
    "spacing" : 8,
    "margin"  : { "top": 4, "bottom": 0, "left": 8, "right": 8 }
  },
  "layout": {
